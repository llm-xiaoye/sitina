# SitinaHub unified configuration

export SITINA_HOME="${SITINA_HOME:-$HOME/SitinaHub}"

export SITINA_BIN_DIR="$SITINA_HOME/bin"
export SITINA_CONFIG_DIR="$SITINA_HOME/config"
export SITINA_PROFILE_DIR="$SITINA_HOME/profiles"
export SITINA_AGENT_DIR="$SITINA_HOME/agents"
export SITINA_CORE_DIR="$SITINA_HOME/core"
export SITINA_DOCS_DIR="$SITINA_HOME/docs"
export SITINA_STATE_DIR="$SITINA_HOME/state"
export SITINA_TEMP_DIR="$SITINA_HOME/temp"
export SITINA_BACKUPS_DIR="$SITINA_HOME/backups"

export SITINA_LOG_ROOT="${SITINA_LOG_ROOT:-$SITINA_HOME/logs/runs}"
export SITINA_CONVERSATION_ROOT="${SITINA_CONVERSATION_ROOT:-$SITINA_HOME/logs/conversations}"

export SITINA_DEFAULT_PROFILE="${SITINA_DEFAULT_PROFILE:-deepseek}"
export SITINA_EFFORT_LEVEL="${SITINA_EFFORT_LEVEL:-max}"
export SITINA_MAX_REWORKS="${SITINA_MAX_REWORKS:-1}"

# Claude Code remains the execution backend. Sitina keeps its own configs.
export SITINA_CLAUDE_CONFIG_DIR="${SITINA_CLAUDE_CONFIG_DIR:-$HOME/ClaudeHub/claude-code/configs/claude}"
