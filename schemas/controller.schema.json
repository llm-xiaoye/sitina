{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref",
          "type": "array"
        },
        "label": {
          "enum": [
            "confirmed",
            "inferred",
            "suggested",
            "unverified",
            "unable_to_verify"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "label"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "artifact",
          "enum": [
            "artifact",
            "file",
            "url",
            "obsidian",
            "audit",
            "event"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "trust_level": {
          "default": "untrusted",
          "enum": [
            "trusted",
            "local_note",
            "official",
            "general_web",
            "untrusted"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "controller",
      "default": "controller",
      "title": "Agent",
      "type": "string"
    },
    "agent_status": {
      "enum": [
        "ok",
        "need_more_input",
        "cannot_complete"
      ],
      "title": "Agent Status",
      "type": "string"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blocked Reason"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "decision": {
      "enum": [
        "next_agent",
        "skip",
        "insert",
        "rework",
        "block",
        "approval",
        "summarize"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "mandatory_steps_ack": {
      "default": true,
      "title": "Mandatory Steps Ack",
      "type": "boolean"
    },
    "need_coder": {
      "title": "Need Coder",
      "type": "boolean"
    },
    "need_filesystem": {
      "title": "Need Filesystem",
      "type": "boolean"
    },
    "need_planner": {
      "title": "Need Planner",
      "type": "boolean"
    },
    "need_reviewer": {
      "title": "Need Reviewer",
      "type": "boolean"
    },
    "need_tester": {
      "title": "Need Tester",
      "type": "boolean"
    },
    "next_agent": {
      "enum": [
        "controller",
        "planner",
        "architect",
        "coder",
        "tester",
        "reviewer",
        "security",
        "critic",
        "arbiter",
        "researcher",
        "memory",
        "summary"
      ],
      "title": "Next Agent",
      "type": "string"
    },
    "next_agents": {
      "items": {
        "enum": [
          "controller",
          "planner",
          "architect",
          "coder",
          "tester",
          "reviewer",
          "security",
          "critic",
          "arbiter",
          "researcher",
          "memory",
          "summary"
        ],
        "type": "string"
      },
      "title": "Next Agents",
      "type": "array"
    },
    "requested_tools": {
      "items": {
        "type": "string"
      },
      "title": "Requested Tools",
      "type": "array"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_paths": {
      "items": {
        "type": "string"
      },
      "title": "Target Paths",
      "type": "array"
    },
    "task_type": {
      "enum": [
        "chat",
        "local_file_query",
        "code_change",
        "high_risk_code_change",
        "maintenance",
        "memory_review",
        "mcp_tool_task"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "verification_status": {
      "default": "not_verified",
      "enum": [
        "not_verified",
        "partially_verified",
        "verified",
        "unable_to_verify"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent_status",
    "decision",
    "next_agent",
    "task_type",
    "need_planner",
    "need_coder",
    "need_filesystem",
    "need_tester",
    "need_reviewer",
    "risk_level",
    "requested_tools",
    "target_paths",
    "next_agents",
    "blocked_reason"
  ],
  "title": "ControllerOutput",
  "type": "object"
}
