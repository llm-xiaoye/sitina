{
  "$defs": {
    "AgentBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "within_budget",
          "enum": [
            "within_budget",
            "compressed",
            "escalated",
            "blocked"
          ],
          "title": "Action",
          "type": "string"
        },
        "input_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens Used",
          "type": "integer"
        },
        "output_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens Used",
          "type": "integer"
        },
        "run_tokens_remaining": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Tokens Remaining"
        },
        "tool_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Tokens Used",
          "type": "integer"
        }
      },
      "title": "AgentBudgetReport",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref",
          "type": "array"
        },
        "label": {
          "enum": [
            "confirmed",
            "inferred",
            "suggested",
            "unverified",
            "unable_to_verify"
          ],
          "title": "Label",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "label"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "artifact",
          "enum": [
            "artifact",
            "file",
            "url",
            "obsidian",
            "audit",
            "event"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "trust_level": {
          "default": "untrusted",
          "enum": [
            "trusted",
            "local_note",
            "official",
            "general_web",
            "untrusted"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ReviewerFinding": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "severity",
        "file",
        "message"
      ],
      "title": "ReviewerFinding",
      "type": "object"
    },
    "ReviewerRejection": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "rework",
            "reject",
            "block"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "required_changes": {
          "items": {
            "type": "string"
          },
          "title": "Required Changes",
          "type": "array"
        },
        "requirement_refs": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Refs",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "reason_code",
        "requirement_refs",
        "evidence_refs"
      ],
      "title": "ReviewerRejection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "reviewer",
      "default": "reviewer",
      "title": "Agent",
      "type": "string"
    },
    "agent_status": {
      "enum": [
        "ok",
        "need_more_input",
        "cannot_complete"
      ],
      "title": "Agent Status",
      "type": "string"
    },
    "budget_report": {
      "$ref": "#/$defs/AgentBudgetReport"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "decision": {
      "default": "accept",
      "enum": [
        "accept",
        "request_changes",
        "blocked"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewerFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "original_requirement_assessment": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Original Requirement Assessment",
      "type": "array"
    },
    "overall_recommendation": {
      "enum": [
        "accept",
        "request_changes",
        "block"
      ],
      "title": "Overall Recommendation",
      "type": "string"
    },
    "rejection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewerRejection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resolved_findings": {
      "items": {
        "type": "string"
      },
      "title": "Resolved Findings",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_status": {
      "default": "not_verified",
      "enum": [
        "not_verified",
        "partially_verified",
        "verified",
        "unable_to_verify"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent_status",
    "overall_recommendation"
  ],
  "title": "ReviewerOutput",
  "type": "object"
}
