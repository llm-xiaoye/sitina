{
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "agent_status",
    "decision",
    "verification_status",
    "conflict_id",
    "conflict_type",
    "resolution_reason",
    "rework_required"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "agent": {"const": "arbiter"},
    "agent_status": {"enum": ["ok", "need_more_input", "cannot_complete"]},
    "decision": {"enum": ["grant_agent_a", "grant_agent_b", "merge", "block", "ask_user"]},
    "evidence": {"type": "array"},
    "claims": {"type": "array"},
    "verification_status": {"enum": ["not_verified", "partially_verified", "verified", "unable_to_verify"]},
    "warnings": {"type": "array"},
    "extensions": {"type": "object"},
    "conflict_id": {"type": "string"},
    "conflict_type": {"type": "string"},
    "winning_agent": {"type": ["string", "null"]},
    "resolution_reason": {"type": "string"},
    "rework_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
