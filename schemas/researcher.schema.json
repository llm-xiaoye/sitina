{
  "$defs": {
    "AgentBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "within_budget",
          "enum": [
            "within_budget",
            "compressed",
            "escalated",
            "blocked"
          ],
          "title": "Action",
          "type": "string"
        },
        "input_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens Used",
          "type": "integer"
        },
        "output_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens Used",
          "type": "integer"
        },
        "run_tokens_remaining": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Tokens Remaining"
        },
        "tool_tokens_used": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Tokens Used",
          "type": "integer"
        }
      },
      "title": "AgentBudgetReport",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref",
          "type": "array"
        },
        "label": {
          "enum": [
            "confirmed",
            "inferred",
            "suggested",
            "unverified",
            "unable_to_verify"
          ],
          "title": "Label",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "label"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "artifact",
          "enum": [
            "artifact",
            "file",
            "url",
            "obsidian",
            "audit",
            "event"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "trust_level": {
          "default": "untrusted",
          "enum": [
            "trusted",
            "local_note",
            "official",
            "general_web",
            "untrusted"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "researcher",
      "default": "researcher",
      "title": "Agent",
      "type": "string"
    },
    "agent_status": {
      "enum": [
        "ok",
        "need_more_input",
        "cannot_complete"
      ],
      "title": "Agent Status",
      "type": "string"
    },
    "budget_report": {
      "$ref": "#/$defs/AgentBudgetReport"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "decision": {
      "default": "evidence",
      "enum": [
        "evidence",
        "cannot_complete"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Facts",
      "type": "array"
    },
    "inferences": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Inferences",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_freshness": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Freshness",
      "type": "object"
    },
    "sources_checked": {
      "items": {
        "type": "string"
      },
      "title": "Sources Checked",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "untrusted_blocks": {
      "items": {
        "type": "string"
      },
      "title": "Untrusted Blocks",
      "type": "array"
    },
    "verification_status": {
      "default": "not_verified",
      "enum": [
        "not_verified",
        "partially_verified",
        "verified",
        "unable_to_verify"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent_status",
    "sources_checked"
  ],
  "title": "ResearcherOutput",
  "type": "object"
}
