{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref",
          "type": "array"
        },
        "label": {
          "enum": [
            "confirmed",
            "inferred",
            "suggested",
            "unverified",
            "unable_to_verify"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "label"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "artifact",
          "enum": [
            "artifact",
            "file",
            "url",
            "obsidian",
            "audit",
            "event"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "trust_level": {
          "default": "untrusted",
          "enum": [
            "trusted",
            "local_note",
            "official",
            "general_web",
            "untrusted"
          ],
          "title": "Trust Level",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MemoryCandidateProposal": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 64,
          "title": "Evidence",
          "type": "array"
        },
        "memory_type": {
          "default": "general",
          "enum": [
            "general",
            "preference",
            "workflow_rule",
            "fact",
            "lesson",
            "constraint"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "sensitivity_level": {
          "default": "low",
          "enum": [
            "low",
            "moderate",
            "high",
            "restricted"
          ],
          "title": "Sensitivity Level",
          "type": "string"
        },
        "source": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "content",
        "reason",
        "confidence",
        "source"
      ],
      "title": "MemoryCandidateProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "memory",
      "default": "memory",
      "title": "Agent",
      "type": "string"
    },
    "agent_status": {
      "enum": [
        "ok",
        "need_more_input",
        "cannot_complete"
      ],
      "title": "Agent Status",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/MemoryCandidateProposal"
      },
      "maxItems": 32,
      "title": "Candidates",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "decision": {
      "default": "candidate",
      "enum": [
        "candidate",
        "none",
        "cannot_complete"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_status": {
      "default": "not_verified",
      "enum": [
        "not_verified",
        "partially_verified",
        "verified",
        "unable_to_verify"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "agent_status"
  ],
  "title": "MemoryOutput",
  "type": "object"
}
